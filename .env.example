# --------------------------
# Backend (required/critical)
# --------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
BACKEND_BASE_URL="http://localhost:4000"
APP_BASE_URL="http://localhost:4000"
FRONTEND_BASE_URL="http://localhost:3000"
FRONTEND_ORIGIN="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000"

AUTH_ENABLED="false"
AUTH_SESSION_SECRET="replace-with-a-long-random-secret"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAME_SITE="lax"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# --------------------------
# Provider/API keys
# --------------------------
OPENAI_API_KEY=""
OPENAI_AGENT_PROVIDER_ENABLED="false"
OPENAI_AGENT_MODEL="gpt-5.4-mini"
OPENAI_AGENT_MODEL_FALLBACK=""
OPENAI_AGENT_MAX_TOOL_CALLS="5"
OPENAI_AGENT_MAX_COMPLETION_TOKENS="800"
OPENAI_AGENT_TIMEOUT_MS="30000"
OPENAI_DAILY_REQUEST_LIMIT_PER_USER=""
OPENAI_MONTHLY_REQUEST_LIMIT_GLOBAL=""
OPENAI_REPORT_MODEL="gpt-5.4-mini"
OPENAI_DEEP_RESEARCH_MODEL="gpt-5.5"
OPENAI_AGENT_ENABLE_ESCALATION="false"

FMP_API_KEY=""
FMP_BASE_URL="https://financialmodelingprep.com/stable"
FRED_API_KEY=""
FRED_BASE_URL="https://api.stlouisfed.org/fred"

# --------------------------
# Provider/network controls
# --------------------------
PROVIDER_HTTP_TIMEOUT_MS="20000"
BANK_OF_CANADA_BASE_URL="https://www.bankofcanada.ca/valet"
BANK_OF_CANADA_USD_CAD_SERIES_ID="FXUSDCAD"
GDELT_BASE_URL="https://api.gdeltproject.org/api/v2"
GDELT_TIMEOUT_MS="20000"
GDELT_QUERY_DELAY_MS="250"
GDELT_MAX_RETRY_429="1"

PRINT_ROUTES_ON_STARTUP="false"

# --------------------------
# Frontend (set in frontend project/deployment)
# --------------------------
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_AUTH_CALLBACK_PATH="/auth/callback"
